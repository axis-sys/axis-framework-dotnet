<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="axis-github" value="https://nuget.pkg.github.com/axis-sys/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <axis-github>
      <add key="Username" value="%AXIS_NUGET_USER%" />
      <add key="ClearTextPassword" value="%AXIS_NUGET_TOKEN%" />
    </axis-github>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="axis-github">
      <package pattern="Axis*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
